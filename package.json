{
  "name": "reserva",
  "version": "0.1.0",
  "private": true,
  "description": "Reserva — online reservation platform for salons (monorepo)",
  "type": "module",
  "scripts": {
    "dev:partner": "pnpm --filter @reserva/partner-backoffice dev",
    "dev:internal": "pnpm --filter @reserva/internal-backoffice dev",
    "dev:client": "pnpm --filter @reserva/client dev",
    "build:partner": "pnpm --filter @reserva/partner-backoffice build",
    "build:internal": "pnpm --filter @reserva/internal-backoffice build",
    "build:client": "pnpm --filter @reserva/client build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
