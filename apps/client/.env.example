# Reserva API base URL (no trailing slash)
VITE_API_URL=http://localhost:4000/api/v1

# Sentry error monitoring (optional; blank = disabled in dev)
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development

# Site analytics seal key (base64url, 32 bytes). Unset = the built-in contract
# default; when set it must equal the backend's SITE_PULSE_KEY.
# VITE_SITE_PULSE_KEY=
