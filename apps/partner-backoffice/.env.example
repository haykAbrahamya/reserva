# Reserva API base URL (no trailing slash)
VITE_API_URL=http://localhost:4000/api/v1

# Sentry error monitoring (optional; blank = disabled in dev)
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development

# Google Maps key for the Locations map picker (optional; blank = picker hidden,
# form falls back to a plain address input). Needs Maps JavaScript API + Places
# API + Geocoding API enabled. Restrict by HTTP referrer.
VITE_GOOGLE_MAPS_KEY=
