VITE_API_URL=https://api.reserva.am/api/v1

# Where a salon that already has an account signs in, and where the activation
# email lands. Must match BACKOFFICE_URL on the API — the backend builds the
# magic link from its own copy, and two different hosts for "sign in" and "the
# link we just emailed you" is how someone ends up with two tabs and no session.
VITE_BACKOFFICE_URL=https://backoffice.reserva.am
