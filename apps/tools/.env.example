# Main Reserva site, for the "online booking" / "try Reserva" links (no trailing slash).
VITE_PLATFORM_URL=https://reserva.am
# The API the analytics beacon reports to (POST /public/pulse), same as reserva.am's.
VITE_API_URL=http://localhost:4000/api/v1
# Analytics seal key. Leave unset to use the contract's default; when set it must
# equal the backend's SITE_PULSE_KEY (and the client app's VITE_SITE_PULSE_KEY).
# VITE_SITE_PULSE_KEY=
